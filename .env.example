# Postgres connection string (Neon's pooled connection string recommended for hosted use)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required for extract_key_findings_llm and the topic-label enrichment in discover_research_topics
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when hosting remotely (e.g. on Vercel). Leave both unset for local stdio use -
# OAuth is skipped entirely when MCP_SERVER_URL is not set.
#
# MCP_SERVER_URL: the public URL this deployment is reachable at, e.g.
#   https://arxiv-research-mcp.vercel.app
# MCP_AUTH_TOKEN: the password you type into the login form when a client
# (e.g. Claude.ai's "Add custom connector") completes its OAuth flow against
# this server - NOT something you paste directly into the client itself.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
