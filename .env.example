# Postgres connection string (Neon's pooled connection string recommended for hosted use)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required for extract_key_findings_llm and the topic-label enrichment in discover_research_topics
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when hosting remotely (e.g. on Vercel). Leave unset for local stdio use -
# auth is skipped entirely when this is not set. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
